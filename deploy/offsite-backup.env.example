# Stell22 offsite backup configuration example.
# Copy to a root-only file outside git, mode 0600, during a later activation.
# This example contains no credentials and no private age key.

OFFSITE_ENDPOINT=https://storage.yandexcloud.net
OFFSITE_BUCKET=stell22-offsite-backups
OFFSITE_REGION=ru-central1
OFFSITE_PREFIX=stell22/offsite/v1
# Public age recipient only. Never put AGE-SECRET-KEY in this file.
OFFSITE_AGE_RECIPIENT=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
OFFSITE_BACKUP_DIR=/root/Stell22/backups
OFFSITE_STATE_DIR=/root/Stell22/backups/offsite-state
OFFSITE_MIN_FREE_KB=1048576
OFFSITE_MAX_AGE_HOURS=36
OFFSITE_GRACE_HHMM=0330
OFFSITE_LOOKBACK_DAYS=40
OFFSITE_ENVIRONMENT=production

# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are supplied by the service
# environment at activation. Do not commit them and do not place them here.
